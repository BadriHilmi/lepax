// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function addsSignedInUserAsFriend(userId) {
      return signedIn()
        && userId != request.auth.uid
        && onlyChanges(["friends"])
        && resource.data.friends is list
        && request.resource.data.friends is list
        && request.resource.data.friends.size() == resource.data.friends.size() + 1
        && request.resource.data.friends.hasAll(resource.data.friends)
        && request.resource.data.friends.hasAll([request.auth.uid])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends.hasAll([userId]);
    }

    // Users: authenticated users can read any profile; only owner can write
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && (request.auth.uid == userId || addsSignedInUserAsFriend(userId));
    }

    // Plans: authenticated users can read; only host can delete
    match /plans/{planId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn(); // likes, forks, joins
      allow delete: if request.auth.uid == resource.data.hostId;
    }

    // Nudges: sender can create; recipient can read and update (mark read)
    match /nudges/{nudgeId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow read, update: if signedIn()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);
    }

    // Friend requests: sender can create; both parties can read/update
    match /friendRequests/{reqId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow read, update: if signedIn()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);
    }
  }
}
